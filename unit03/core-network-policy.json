{
  "version": "2025.11",
  "core-network-configuration": {
    "asn-ranges": ["64512-64555"],
    "edge-locations": [
      { "location": "us-east-1" },
      { "location": "eu-west-1" }
    ]
  },
  "segments": [
    { "name": "hybrid", "description": "Direct Connect gateway attachment" },
    { "name": "prod", "description": "Production VPCs" },
    { "name": "dr", "description": "Disaster recovery VPCs" }
  ],
  "segment-actions": [
    {
      "action": "share",
      "mode": "attachment-route",
      "segment": "prod",
      "share-with": ["hybrid"],
      "routing-policy-names": ["prodOnlyIn"]
    },
    {
      "action": "share",
      "mode": "attachment-route",
      "segment": "dr",
      "share-with": ["hybrid"],
      "routing-policy-names": ["drOnlyIn"]
    },
    {
      "action": "associate-routing-policy",
      "segment": "hybrid",
      "edge-location-association": {
        "edge-location": "eu-west-1",
        "peer-edge-location": "us-east-1",
        "routing-policy-names": ["keepInUsEast1"]
      }
    }
  ],
  "attachment-policies": [
    {
      "rule-number": 100,
      "conditions": [{ "type": "tag-exists", "key": "segment" }],
      "action": { "association-method": "tag", "tag-value-of-key": "segment" }
    }
  ],
  "attachment-routing-policy-rules": [
    {
      "rule-number": 100,
      "description": "Direct Connect at us-east-1",
      "edge-locations": ["us-east-1"],
      "conditions": [{ "type": "routing-policy-label", "value": "dxOnPrem" }],
      "action": { "associate-routing-policies": ["markUsEast1"] }
    },
    {
      "rule-number": 110,
      "description": "Direct Connect at eu-west-1",
      "edge-locations": ["eu-west-1"],
      "conditions": [{ "type": "routing-policy-label", "value": "dxOnPrem" }],
      "action": { "associate-routing-policies": ["keepInUsEast1", "enterViaUsEast1", "markEuWest1"] }
    }
  ],
  "routing-policies": [
    {
      "routing-policy-name": "prodOnlyIn",
      "routing-policy-description": "Into prod from hybrid: only routes tagged 65001:100",
      "routing-policy-direction": "inbound",
      "routing-policy-number": 100,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "community-in-list", "value": "65001:100" }],
            "condition-logic": "and",
            "action": { "type": "allow" }
          }
        },
        {
          "rule-number": 200,
          "rule-definition": {
            "match-conditions": [
              { "type": "prefix-in-cidr", "value": "0.0.0.0/0" },
              { "type": "prefix-equals", "value": "0.0.0.0/0" }
            ],
            "condition-logic": "or",
            "action": { "type": "drop" }
          }
        }
      ]
    },
    {
      "routing-policy-name": "drOnlyIn",
      "routing-policy-description": "Into dr from hybrid: only routes tagged 65001:200",
      "routing-policy-direction": "inbound",
      "routing-policy-number": 110,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "community-in-list", "value": "65001:200" }],
            "condition-logic": "and",
            "action": { "type": "allow" }
          }
        },
        {
          "rule-number": 200,
          "rule-definition": {
            "match-conditions": [
              { "type": "prefix-in-cidr", "value": "0.0.0.0/0" },
              { "type": "prefix-equals", "value": "0.0.0.0/0" }
            ],
            "condition-logic": "or",
            "action": { "type": "drop" }
          }
        }
      ]
    },
    {
      "routing-policy-name": "keepInUsEast1",
      "routing-policy-description": "Routes tagged 65001:400 stay in us-east-1",
      "routing-policy-direction": "inbound",
      "routing-policy-number": 150,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "community-in-list", "value": "65001:400" }],
            "condition-logic": "and",
            "action": { "type": "drop" }
          }
        }
      ]
    },
    {
      "routing-policy-name": "enterViaUsEast1",
      "routing-policy-description": "Routes tagged 65001:310 are made longer where this is applied",
      "routing-policy-direction": "inbound",
      "routing-policy-number": 200,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "community-in-list", "value": "65001:310" }],
            "condition-logic": "and",
            "action": { "type": "prepend-asn-list", "value": [65001, 65001] }
          }
        }
      ]
    },
    {
      "routing-policy-name": "markUsEast1",
      "routing-policy-description": "Tell on-premises which Region advertised the route",
      "routing-policy-direction": "outbound",
      "routing-policy-number": 300,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "prefix-in-cidr", "value": "0.0.0.0/0" }],
            "condition-logic": "and",
            "action": { "type": "add-community", "value": "65001:1001" }
          }
        }
      ]
    },
    {
      "routing-policy-name": "markEuWest1",
      "routing-policy-description": "Tell on-premises which Region advertised the route",
      "routing-policy-direction": "outbound",
      "routing-policy-number": 310,
      "routing-policy-rules": [
        {
          "rule-number": 100,
          "rule-definition": {
            "match-conditions": [{ "type": "prefix-in-cidr", "value": "0.0.0.0/0" }],
            "condition-logic": "and",
            "action": { "type": "add-community", "value": "65001:1002" }
          }
        }
      ]
    }
  ]
}
